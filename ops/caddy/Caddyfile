:8088 {
	# Global options
	request_body {
		max_size 10MB
	}
	
	# Compression
	encode zstd gzip

	# API route
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			# Transport settings
			transport http {
				read_timeout 120s
				write_timeout 120s
				dial_timeout 15s
				response_header_timeout 60s
				keepalive 60s
				keepalive_idle_conns 200
				keepalive_idle_conns_per_host 20
			}
			
			# Retry logic - more aggressive
			lb_policy round_robin
			fail_duration 10s
			max_fails 5
			unhealthy_status 503 502 504 500
			health_interval 3s
			health_timeout 5s
			health_uri /actuator/health
			health_status 200
			
			# Buffer settings
			flush_interval -1
		}
	}

	# Admin frontend route
	@admin path /admin*
	handle @admin {
		reverse_proxy 127.0.0.1:3000 {
			# Transport settings
			transport http {
				read_timeout 120s
				write_timeout 120s
				dial_timeout 15s
				response_header_timeout 60s
				keepalive 60s
				keepalive_idle_conns 200
				keepalive_idle_conns_per_host 20
			}
			
			# Retry logic - more aggressive
			lb_policy round_robin
			fail_duration 10s
			max_fails 5
			unhealthy_status 503 502 504 500
			health_interval 3s
			health_timeout 5s
			health_uri /admin
			health_status 200
			
			# Buffer settings
			flush_interval -1
		}
	}

	# Employee frontend route
	@employee path /employee*
	handle @employee {
		reverse_proxy 127.0.0.1:3001 {
			# Transport settings
			transport http {
				read_timeout 120s
				write_timeout 120s
				dial_timeout 15s
				response_header_timeout 60s
				keepalive 60s
				keepalive_idle_conns 200
				keepalive_idle_conns_per_host 20
			}
			
			# Retry logic - more aggressive
			lb_policy round_robin
			fail_duration 10s
			max_fails 5
			unhealthy_status 503 502 504 500
			health_interval 3s
			health_timeout 5s
			health_uri /employee/login
			health_status 200
			
			# Buffer settings
			flush_interval -1
		}
	}

	# Static assets caching
	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy {
			to 127.0.0.1:3000 127.0.0.1:3001
			lb_policy round_robin
			transport http {
				keepalive 30s
				keepalive_idle_conns 50
			}
		}
	}

	# Root redirect
	@root path /
	redir @root /admin
}
